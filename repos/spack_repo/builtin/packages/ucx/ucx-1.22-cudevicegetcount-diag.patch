UCX 1.22: log cuDeviceGetCount failure in uct_cuda_ctx_primary_push_first_active() at DIAG.
On nodes with libcuda but no GPU/driver, uct_ib_mlx5 GDA init calls this during IB md open and
every process printed 'UCX ERROR cuDeviceGetCount(&num_devices) failed: initialization error'.
Same level as the other cuDeviceGetCount calls in cuda_ctx.c/cuda_md.c; cf. upstream PR #10528.

--- a/src/uct/cuda/base/cuda_ctx.c	2026-11-21 19:44:16.000000000 -0700
+++ b/src/uct/cuda/base/cuda_ctx.c	2026-11-21 19:44:16.000000000 -0700
@@ -49,7 +49,7 @@
     ucs_status_t status;
     CUdevice cuda_device;
 
-    status = UCT_CUDADRV_FUNC_LOG_ERR(cuDeviceGetCount(&num_devices));
+    status = UCT_CUDADRV_FUNC(cuDeviceGetCount(&num_devices), UCS_LOG_LEVEL_DIAG);
     if (status != UCS_OK) {
         return status;
     }
